{
  "lsp": {
    "tinymist": {
      "initialization_options": {
        // Enable background preview
        // Server will be running on 127.0.0.1:23635
        "preview": {
          "background": {
            "enabled": true,
          },
          "invertColors": "never",
        },
      },
      "settings": {
        "projectResolution": "lockDatabase",
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
      },
    },
  },
}
